<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Friendly shark — a DeepSeek pun. Built from an ellipse + triangles, not a
         single freehand blob, so the silhouette stays clean at every size. -->
    <!-- Tail fin -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M68,46 L84,36 L74,54 L84,74 L68,62 Z" />
    <!-- Body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,54 A22,10 0 1 0 70,54 A22,10 0 1 0 26,54 Z" />
    <!-- Dorsal fin -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,48 L50,30 L58,49 Z" />
    <!-- Pectoral fin -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,64 L34,78 L54,68 Z" />
    <!-- Eye -->
    <path
        android:fillColor="#FF0A0E1C"
        android:pathData="M32,50 m-2.6,0 a2.6,2.6 0 1,1 5.2,0 a2.6,2.6 0 1,1 -5.2,0" />
    <!-- Smile — stroke only; a fillColor here would also fill the curve's
         implicit closing edge, thickening it into an unwanted crescent. -->
    <path
        android:strokeColor="#FF0A0E1C"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M26,58 Q34,63 42,58" />
</vector>
